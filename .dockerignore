# Reduce el contexto de build y evita meter secretos/archivos pesados en la
# imagen. NOTA: corpus/ SÍ se incluye porque el ingest lo procesa en build
# time para construir el índice ChromaDB; chroma_db/ ya no se copia (se
# genera durante el build).

# Entornos y cachés de Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Secretos y entorno local
.env
.env.local

# Git y metadatos
.git/
.gitignore
.claude/

# Datos locales y logs
data/
*.log

# Pruebas y documentación de QA
tests/

# Landing comercial y assets no servidos por la app principal
index.html
privacy.html
favicon.svg

# Documentación / notas
README.md
CLAUDE.md
skills/
supabase_schema.sql

# SO
.DS_Store
Thumbs.db
