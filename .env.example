# Copia este archivo a .env y rellena los valores.
# El archivo .env nunca se sube al repo (ver .gitignore).

# === LLM ===
ANTHROPIC_API_KEY=sk-ant-...

# === Embeddings + reranking (Voyage AI por API) ===
VOYAGE_API_KEY=

# === Paths (relativos a la raíz del repo) ===
CHROMA_PERSIST_DIR=./chroma_db
CORPUS_RAW_DIR=./corpus/raw
CORPUS_PROCESSED_DIR=./corpus/processed

# === Modelos ===
LLM_MODEL=claude-haiku-4-5-20251001
EMBED_MODEL=voyage-3
RERANK_MODEL=rerank-2.5

# === Auth beta (magic link) ===
# Resend: en modo prueba con onboarding@resend.dev solo entrega al correo
# dueño de la cuenta. Para enviar a clientes verifica el dominio en Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# Supabase: usa la SERVICE_ROLE key (server-side, ignora RLS). NUNCA la anon.
SUPABASE_URL=
SUPABASE_KEY=
# Clave para POST /api/auth/add-user (alta de usuarios autorizados).
ADMIN_API_KEY=legis-admin-2026
# URL pública donde se sirve la app (base del magic link). En local:
# http://localhost:8000 ; en Render: https://<tu-servicio>.onrender.com
APP_BASE_URL=http://localhost:8000
# Secreto para firmar los JWT de sesión. Genera uno largo y aleatorio,
# p. ej.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# === Logging ===
LOG_LEVEL=INFO
